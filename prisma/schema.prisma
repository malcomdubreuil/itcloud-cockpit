// ITCloud Cockpit — schéma v1.1 (mono-tenant, MySQL 8)
// Conventions : UUID partout, soft delete (deletedAt), tenantId sur toutes
// les tables métier (une seule valeur en v1 — retrofit multi-tenant en v2).
// Règle soft delete × unique : recréer une entité soft-supprimée avec la même
// clé unique = réactiver l'enregistrement existant (voir doc §5.0).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Tenancy & sécurité ───────────────────────────

model Tenant {
  id          String  @id @default(uuid())
  name        String
  itcloudCode String?
  partnerTier String? // Certifié / Or / Platine / Titane / Élite — config v1
  settings    Json    @default("{}")

  users            User[]
  clients          Client[]
  suppliers        Supplier[]
  products         Product[]
  apiCredentials   ApiCredential[]
  fixedCosts       FixedCost[]
  recurringTasks   RecurringTask[]
  mailingContacts  MailingContact[]
  mailingCampaigns MailingCampaign[]
  stickyNotes      StickyNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(uuid())
  tenantId      String
  email         String    @unique
  passwordHash  String
  name          String
  roleId        String
  mfaEnabled    Boolean   @default(false)
  mfaSecretEnc  String? // TOTP chiffré AES-256-GCM
  mfaKeyVersion Int? // version de clé du chiffrement du secret
  lastLoginAt   DateTime?
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  notes       Note[]
  stickyNotes StickyNote[]
  comments    Comment[]
  documents   Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([roleId])
}

model Role {
  id          String @id @default(uuid())
  tenantId    String
  name        String // Admin, Gestionnaire, Comptable, Lecture
  permissions Json // ex. ["clients:read","invoices:write"] ou ["*"]

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model ApiCredential {
  id         String    @id @default(uuid())
  tenantId   String
  provider   String // "ITCLOUD"
  keyEnc     String // AES-256-GCM
  keyVersion Int       @default(1)
  lastUsedAt DateTime?
  rotatedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String? // null si action système (sync)
  action     String // "client.update", "sync.run", "auth.login"…
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────── Clients ──────────────────────────────────

enum PaymentMethod {
  PREAUTORISE
  CHEQUE
  VIREMENT
  CARTE
}

enum BillingType {
  MENSUEL
  ANNUEL
  MIXTE
}

enum ClientStatus {
  ACTIF
  SUSPENDU
  INACTIF
}

model Client {
  id            String         @id @default(uuid())
  tenantId      String
  companyName   String
  contactName   String?
  phone         String?
  email         String?
  clientCode    String? // code client ITCloud — pivot du rapprochement
  paymentMethod PaymentMethod?
  billingType   BillingType?
  status        ClientStatus   @default(ACTIF)
  // Seuil d'alerte du client : jours avant échéance où ses services passent au
  // rouge (30, 45 ou 60). Réglé par client — certains se relancent plus tôt.
  urgencyDays   Int            @default(30)
  // Revendeur : Keven héberge pour lui, et lui facture UNE facture couvrant
  // tous les sites de ses propres clients (Pclogic 147 services, Acxzon 72).
  // Il reste donc un client — c'est lui qu'on facture — mais sa fiche groupe
  // ses services par domaine pour qu'on voie à travers.
  isReseller    Boolean        @default(false)
  // Division d'appartenance. Utile surtout pour un client SANS service (créé à
  // la main) : sa division vient de là. Un client qui a des services apparaît
  // de toute façon du côté de ces services. Défaut ITCLOUD (source historique).
  division      String         @default("ITCLOUD")
  // Client interne = ma propre entreprise (GOD-INFO). On ne se facture pas :
  // prix des services forcés à 0, affichage des prix masqué, pas de bouton
  // « Facturé ». Les services restent listables et annulables.
  internal      Boolean        @default(false)
  anniversary   DateTime?
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  services         ClientService[]
  recurringTasks   RecurringTask[]
  mailingContacts  MailingContact[]
  invoices         Invoice[]
  notes            Note[]
  comments         Comment[]
  documents        Document[]
  tags             Tag[]
  categories       Category[]
  azureConsumption AzureConsumption[]
  alerts           Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, clientCode])
  @@index([tenantId, status])
  @@index([tenantId, companyName])
}

model Note {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String
  authorId  String
  content   String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([tenantId, clientId])
}

model Comment {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([tenantId, clientId])
}

model Document {
  id           String    @id @default(uuid())
  tenantId     String
  clientId     String
  fileName     String
  mimeType     String
  size         Int
  storagePath  String // relatif au répertoire de stockage hors racine web
  uploadedById String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  client     Client @relation(fields: [clientId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, clientId])
}

model Tag {
  id       String @id @default(uuid())
  tenantId String
  name     String
  color    String

  clients Client[]

  @@unique([tenantId, name])
}

model Category {
  id       String @id @default(uuid())
  tenantId String
  name     String

  clients Client[]

  @@unique([tenantId, name])
}

// ──────────────────── Fournisseurs, catalogue, tarifs ─────────────────────

enum BillingCycle {
  MENSUEL
  ANNUEL
  TRIMESTRIEL
}

model Supplier {
  id       String  @id @default(uuid())
  tenantId String
  name     String // Microsoft, Bitdefender, Acronis, Azure…
  group    String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model Product {
  id             String       @id @default(uuid())
  tenantId       String
  supplierId     String
  group          String? // mappé sur BACKUP, ANTIVIRUS, LICENCE, CLOUD (alertes)
  name           String
  description    String?      @db.Text
  sku            String // clé de rapprochement avec l'API
  msrp           Decimal      @db.Decimal(12, 4) // PDSF
  partnerCost    Decimal      @db.Decimal(12, 4) // coût partenaire (niveau courant)
  // Prix vendant suggéré (au cycle du produit). NULL = défaut PDSF + 2 $/mois.
  suggestedPrice Decimal?     @db.Decimal(12, 4)
  // PDSF/coût saisis à la main : ni la synchro ni un ré-import ne les écrasent.
  priceManual    Boolean      @default(false)
  // false = produit maison (hébergement, domaines, SSL…) : la synchronisation
  // ITCloud l'ignore complètement, sinon ses services apparaîtraient pour
  // toujours dans « absents du rapport ITCloud ».
  itcloudManaged Boolean      @default(true)
  // Division commerciale : deux « entreprises » cohabitent dans l'ERP et se
  // basculent au bouton (ITCLOUD = licences, HEBERGEMENT = web). Champ distinct
  // de itcloudManaged, qui dit seulement si la synchro ITCloud gere le produit.
  // Volontairement une chaine et non un enum : une 3e division est prevue.
  division       String       @default("ITCLOUD")
  billingCycle   BillingCycle
  active         Boolean      @default(true)
  deletedAt      DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  services       ClientService[]
  priceOverrides PriceOverride[]
  fixedCosts     FixedCost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku, billingCycle])
  @@index([tenantId, supplierId])
  @@index([tenantId, group])
}

model PriceOverride {
  id            String   @id @default(uuid())
  tenantId      String
  productId     String
  clientId      String? // null = prix par défaut du tenant
  price         Decimal  @db.Decimal(12, 4)
  effectiveFrom DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, productId, clientId])
}

// ─────────────────────────── Services clients ─────────────────────────────

enum ServiceStatus {
  EN_ATTENTE
  ACTIF
  SUSPENDU
  ANNULE
  EXPIRE
}

// Mode de facturation ITCloud : INDIRECT = le partenaire facture son client
// (le cœur du logiciel) ; DIRECT = ITCloud facture le client directement,
// donc rien à refacturer (exclu des listes « à facturer » par défaut).
enum BillingMode {
  INDIRECT
  DIRECT
}

model ClientService {
  id                String        @id @default(uuid())
  tenantId          String
  clientId          String
  productId         String
  matchKey          String // clientCode|sku|billingCycle (rapprochement §5.4)
  externalId        String? // si l'API expose un jour un id stable
  licenseKey        String?
  assignedUser      String?
  quantity          Int
  // Quantité fixée à la main : la synchronisation ITCloud ne l'écrase plus.
  quantityManual    Boolean       @default(false)
  // Échéance fixée à la main : ni la synchro ni un recalcul ne l'écrasent.
  renewalDateManual Boolean       @default(false)
  unitCost          Decimal       @db.Decimal(12, 4) // snapshot coût au moment T
  unitPrice         Decimal       @db.Decimal(12, 4) // snapshot prix de vente
  purchaseDate      DateTime?
  renewalDate       DateTime?
  // Fin de la période d'engagement chez ITCloud (commitmentEndDate).
  commitmentEndDate DateTime?
  status            ServiceStatus @default(ACTIF)
  billingMode       BillingMode   @default(INDIRECT)
  missingSince      DateTime? // 1re sync SUCCES où l'item est absent (§7.2)
  // Facturation au mois : quand true, la refacturation avance les dates de
  // +1 mois (au lieu du cycle du produit) — service annuel refacturé mensuellement.
  monthlyBilling    Boolean       @default(false)
  // Seuil d'urgence (jours avant échéance) où le service passe au rouge : 30, 45 ou 60.
  urgencyDays       Int           @default(30)
  // Serveur / revendeur qui porte le service (Acxzon, God, Pc Logic…). Les
  // tarifs de Keven diffèrent d'un serveur à l'autre pour un même produit,
  // d'où une vraie colonne plutôt qu'un bout de la note.
  serverName        String?

  // Aide à la refacturation : derniers numéros de facture (éditables ;
  // celui d'ITCloud sera aussi alimenté par la sync invoice-items en phase 1)
  lastQbInvoiceNo      String? // dernière facture QuickBooks (GOD-INFO) au client
  lastItcloudInvoiceNo String? // dernière facture ITCloud pour ce service
  notes                String? @db.Text // notes libres par service (ex-colonne M du fichier Excel)

  deletedAt DateTime?

  client  Client  @relation(fields: [clientId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  changes      ServiceChange[]
  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, matchKey])
  @@index([tenantId, renewalDate])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
}

enum ChangeType {
  CREATION
  MODIFICATION
  ANNULATION
  REACTIVATION
  QTE
  PRIX
  SUSPENSION
  RENOUVELLEMENT
}

enum ChangeSource {
  SYNC
  MANUEL
}

model ServiceChange {
  id         String       @id @default(uuid())
  tenantId   String
  serviceId  String
  changeType ChangeType
  field      String?
  oldValue   Json?
  newValue   Json?
  source     ChangeSource
  syncRunId  String?
  userId     String?
  createdAt  DateTime     @default(now())

  service ClientService @relation(fields: [serviceId], references: [id])
  syncRun SyncRun?      @relation(fields: [syncRunId], references: [id])

  @@index([tenantId, serviceId, createdAt])
}

// ───────────────────────────── Synchronisation ────────────────────────────

enum SyncTrigger {
  SCHEDULE
  MANUEL
}

enum SyncStatus {
  EN_COURS
  SUCCES
  ERREUR
  PARTIEL
}

model SyncRun {
  id           String      @id @default(uuid())
  tenantId     String
  trigger      SyncTrigger
  endpoint     String // services-report, invoice-items-report, azure…
  status       SyncStatus
  startedAt    DateTime
  finishedAt   DateTime?
  itemsFetched Int         @default(0)
  itemsCreated Int         @default(0)
  itemsUpdated Int         @default(0)
  itemsFlagged Int         @default(0)
  errorMessage String?     @db.Text
  rawPayload   Json? // rétention 30 jours

  changes          ServiceChange[]
  azureConsumption AzureConsumption[]

  @@index([tenantId, startedAt])
  @@index([tenantId, status])
}

model AzureConsumption {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String
  period    DateTime // mois
  category  String?
  costCad   Decimal  @db.Decimal(12, 4)
  budgetCad Decimal? @db.Decimal(12, 2)
  syncRunId String

  client  Client  @relation(fields: [clientId], references: [id])
  syncRun SyncRun @relation(fields: [syncRunId], references: [id])

  @@unique([tenantId, clientId, period, category])
}

// ─────────────────────────────── Facturation ──────────────────────────────

enum InvoiceStatus {
  BROUILLON
  ENVOYEE
  PAYEE
  EN_RETARD
  ANNULEE
}

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String
  clientId    String
  number      String // attribué via InvoiceSequence (SELECT … FOR UPDATE)
  periodStart DateTime
  periodEnd   DateTime
  subtotal    Decimal       @db.Decimal(12, 2)
  tps         Decimal       @db.Decimal(12, 2) // 5 %
  tvq         Decimal       @db.Decimal(12, 2) // 9,975 %
  total       Decimal       @db.Decimal(12, 2)
  costTotal   Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(BROUILLON)
  dueDate     DateTime?
  paidAt      DateTime?
  deletedAt   DateTime?

  client Client        @relation(fields: [clientId], references: [id])
  items  InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
}

model InvoiceSequence {
  tenantId   String @id
  nextNumber Int    @default(1)
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 4)
  unitCost    Decimal @db.Decimal(12, 4)
  prorata     Boolean @default(false)
  lineTotal   Decimal @db.Decimal(12, 2)

  invoice Invoice        @relation(fields: [invoiceId], references: [id])
  service ClientService? @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
}

// ──────────────────────────────── Alertes ─────────────────────────────────

enum AlertType {
  RENOUVELLEMENT_30J
  LICENCE_EXPIREE
  PRODUIT_SUSPENDU
  PAIEMENT_ECHOUE
  SANS_SAUVEGARDE
  SANS_ANTIVIRUS
  AZURE_SANS_BUDGET
  FACTURE_IMPAYEE
  MARGE_NEGATIVE
}

enum Severity {
  INFO
  ATTENTION
  CRITIQUE
}

enum AlertStatus {
  OUVERTE
  VUE
  RESOLUE
  IGNOREE
}

model Alert {
  id         String      @id @default(uuid())
  tenantId   String
  type       AlertType
  severity   Severity
  clientId   String?
  serviceId  String?
  invoiceId  String?
  message    String
  status     AlertStatus @default(OUVERTE)
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())

  client Client? @relation(fields: [clientId], references: [id])

  @@index([tenantId, status, severity])
  @@index([tenantId, type, clientId, serviceId, invoiceId])
}

// ────────────────────────────── Snapshots KPI ─────────────────────────────

model DailyKpiSnapshot {
  id            String   @id @default(uuid())
  tenantId      String
  date          DateTime // jour (00:00)
  mrr           Decimal  @db.Decimal(14, 2)
  arr           Decimal  @db.Decimal(14, 2)
  monthlyProfit Decimal  @db.Decimal(14, 2)
  licenseCount  Int
  clientCount   Int
  createdAt     DateTime @default(now())

  @@unique([tenantId, date])
}

// Coût fixe d'exploitation : un montant global que Keven paie et qu'il revend
// réparti sur plusieurs clients (un serveur, une licence illimitée, un
// certificat wildcard…). À l'opposé de ClientService.unitCost, qui est un coût
// PAR licence — inadapté à l'hébergement, où le même 200 $/mois couvre 120
// sites. Rattachable à un produit et/ou à un serveur, ou laissé global à la
// division.
model FixedCost {
  id         String       @id @default(uuid())
  tenantId   String
  division   String // ITCLOUD / HEBERGEMENT — même code que Product.division
  label      String
  amount     Decimal      @db.Decimal(12, 4)
  cycle      BillingCycle // le montant est exprimé à ce cycle
  productId  String? // rattachement optionnel à un produit
  serverName String? // rattachement optionnel à un serveur (Acxzon, Pc Logic…)
  note       String?      @db.Text
  active     Boolean      @default(true)
  deletedAt  DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, division])
  @@index([tenantId, productId])
}

// ─────────────────────── Tâches récurrentes (3e division) ───────────────────
// Revenus récurrents facturés à la main : mise à jour de site web, entretien
// sécurité Office 365… Volontairement DANS SA PROPRE TABLE, séparée des
// produits/services ITCloud et Hébergement : rien à synchroniser, rien à
// rapprocher — juste un montant, une période en jours et une échéance.
model RecurringTask {
  id       String @id @default(uuid())
  tenantId String
  clientId String

  title      String // « Mise à jour site web », « Entretien sécurité Office 365 »
  // Montant facturé à CHAQUE occurrence (pas au mois : au cycle de la tâche).
  price      Decimal @db.Decimal(12, 4)
  // Période en JOURS : 30 = mensuel, 365 = annuel. Libre pour les cas à part.
  periodDays Int     @default(30)

  // Prochaine échéance : c'est elle qui donne la couleur d'urgence et qui
  // avance de periodDays à chaque facturation.
  nextDueDate     DateTime?
  lastQbInvoiceNo String? // dernière facture QuickBooks (source à dupliquer)
  lastBilledAt    DateTime?
  notes           String?   @db.Text

  active    Boolean   @default(true)
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, nextDueDate])
  @@index([tenantId, clientId])
  @@index([tenantId, active])
}

// ────────────────── Liste de diffusion (4e division) ────────────────────────
// Envoi de courriels de masse aux clients. Tables DÉDIÉES : rien à voir avec
// la facturation. Deux règles structurantes (LCAP / loi canadienne
// anti-pourriel) :
//  1. le désabonnement ne coupe QUE le marketing — jamais les factures ni les
//     avis de service, qui ne passent pas par ici ;
//  2. on garde la PREUVE du consentement (source, date, IP) : c'est elle qui
//     protège en cas de plainte.

model MailingContact {
  id       String  @id @default(uuid())
  tenantId String
  // Un client peut avoir PLUSIEURS contacts (proprio, comptabilité, TI).
  // Null = abonné venu du site web, sans fiche client.
  clientId String?

  email String
  name  String?
  role  String? // « Comptabilité », « Propriétaire »… simple étiquette

  // Consentement : TACITE (client actif, valable 2 ans après la dernière
  // transaction), EXPRES (s'est abonné lui-même), RETIRE (désabonné).
  consent       String    @default("TACITE")
  consentSource String? // « import ERP », « site web », « manuel »
  consentAt     DateTime?
  consentIp     String? // preuve pour un consentement exprès

  // Désabonnement : jeton du lien public, à usage permanent.
  unsubToken     String    @unique
  unsubscribedAt DateTime?

  // Santé de l'adresse : réenvoyer à une adresse morte détruit la réputation
  // du domaine — donc celle qui envoie aussi les factures.
  bouncedAt   DateTime?
  bounceCount Int       @default(0)

  active    Boolean   @default(true)
  deletedAt DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  client     Client?           @relation(fields: [clientId], references: [id])
  deliveries MailingDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, clientId])
  @@index([tenantId, active])
}

model MailingCampaign {
  id       String @id @default(uuid())
  tenantId String

  name     String // « Infolettre novembre » — usage interne
  subject  String
  bodyHtml String  @db.Text
  bodyText String? @db.Text

  // Critères de ciblage (division, groupe de produit, recherche…) : conservés
  // pour savoir À QUI on a écrit, même si les services changent après coup.
  segment Json

  // BROUILLON → EN_COURS → ENVOYEE (ou ANNULEE). L'envoi se fait en file
  // d'attente : 400 courriels prennent ~15 min, une requête web mourrait avant.
  status     String    @default("BROUILLON")
  testMode   Boolean   @default(true) // garde-fou : rien ne part par défaut
  startedAt  DateTime?
  finishedAt DateTime?
  sentCount  Int       @default(0)
  failCount  Int       @default(0)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries MailingDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

// Un enregistrement par destinataire ET par campagne : c'est lui qui garantit
// qu'un contact ne reçoit JAMAIS deux fois la même campagne, même si le cron
// repasse ou plante en plein envoi.
model MailingDelivery {
  id         String @id @default(uuid())
  tenantId   String
  campaignId String
  contactId  String

  email  String // figé à l'envoi : l'adresse peut changer après
  status String    @default("EN_ATTENTE") // EN_ATTENTE | ENVOYE | ECHEC | IGNORE
  error  String?   @db.Text
  sentAt DateTime?

  campaign MailingCampaign @relation(fields: [campaignId], references: [id])
  contact  MailingContact  @relation(fields: [contactId], references: [id])

  createdAt DateTime @default(now())

  @@unique([campaignId, contactId])
  @@index([tenantId, status])
}

// Post-it du tableau de notes (5e onglet). A ne pas confondre avec `Note`,
// qui est une note attachee a une fiche client. Ici il n'y a pas de client :
// c'est un tableau libre, partage par le tenant, ou l'on epingle ce qu'on
// veut et ou la POSITION fait partie de l'information (regrouper trois
// post-it dans un coin, c'est deja les classer).
model StickyNote {
  id       String @id @default(uuid())
  tenantId String
  authorId String

  content String @db.Text
  // Nom de couleur (JAUNE, ROSE...) et non un code hexadecimal : la palette
  // vit dans le code, ce qui permet de la retoucher — et de gerer le mode
  // sombre — sans migrer les donnees.
  color   String @default("JAUNE")

  // Position et taille sur le tableau, en pixels depuis le coin haut-gauche.
  x      Int @default(40)
  y      Int @default(40)
  width  Int @default(260)
  height Int @default(220)
  // Ordre d'empilement : attraper un post-it le remonte au-dessus des autres.
  z      Int @default(0)

  // Verrouille : le post-it ne bouge plus. Utile pour un pense-bete de fond
  // qu'on ne veut pas deplacer par accident en rangeant les autres.
  locked Boolean @default(false)

  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, deletedAt])
}
